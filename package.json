{
  "name": "zkp-health-insurance-hackathon",
  "version": "1.0.0",
  "description": "Privacy-Preserving Health Records & ZKP Insurance Claims Prototype",
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "circuits:compile": "circom circuits/claim_verifier.circom --r1cs --wasm --sym -o circuits/build",
    "contracts:compile": "hardhat compile",
    "contracts:deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "contracts:deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.5"
  }
}
